# Copy this file to terraform.tfvars and keep the copy out of version control.
aws_region        = "us-east-1"
aws_profile       = "default"
app               = "chewbacca-auth-rest"
env               = "dev"
test_user_password = "REPLACE_WITH_A_STRONG_LAB_PASSWORD"

# Replace this before testing Cognito managed login in a browser.
callback_url = "https://example.com/callback"

# Optional: Terraform creates an unconfirmed SNS email subscription when set.
# alert_email = "you@example.com"