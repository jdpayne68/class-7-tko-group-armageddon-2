# ============================================================
# ENVIRONMENT TEMPLATE
# ============================================================
# Rename to env or copy to current env if needed, and update as you create resources.
# Do not commit env with real account IDs, secrets, or lab-specific values.
# ------------------------------------------------------------

# ==============================================================
# INPUTS - PLANNED VALUES
# ==============================================================
# These are planned values that will be used in the deployment.
# Fill these in before deploying infrastructure.

# ------------------------------------------------------------
# 1. Foundational Inputs
# Fill these in with your information.
# ------------------------------------------------------------
# Repository
# REPO_ROOT=""
# PROJECT_NAME=""
# ENVIRONMENT="dev"

# AWS
# AWS_ACCOUNT_ID=""
# AWS_REGION="us-east-1"
# AWS_PROFILE="default"

# Google Cloud
# GCP_PROJECT_ID=""
# GCP_PROJECT_NAME=""
# GCP_REGION="us-central1"
# GCP_ZONE="us-central1-a"

# Azure
# AZURE_SUBSCRIPTION_ID=""
# AZURE_TENANT_ID=""
# AZURE_REGION="eastus"

# Kubernetes
# K8S_CLUSTER_NAME=""
# K8S_NAMESPACE="default"

# ------------------------------------------------------------
# 2. Core Settings
# ------------------------------------------------------------

# Common
RESOURCE_NAME=""
RESOURCE_PREFIX=""
RESOURCE_SUFFIX=""

# Terraform
# TF_WORKSPACE="default"
# TF_STATE_BUCKET=""
# TF_STATE_KEY=""

# Networking
# VPC_NAME=""
# VPC_ID=""
# SUBNET_ID=""
# SECURITY_GROUP_ID=""

# ------------------------------------------------------------
# 3. Planned Resource Names
# ------------------------------------------------------------

# AWS
# LAMBDA_FUNCTION_NAME=""
# API_GATEWAY_NAME=""
# S3_BUCKET_NAME=""
# DYNAMODB_TABLE=""
# IAM_ROLE_NAME=""

# Google Cloud
# GCS_BUCKET_NAME=""
# CLOUD_RUN_SERVICE=""
# CLOUD_FUNCTION_NAME=""
# SERVICE_ACCOUNT_NAME=""

# Azure
# RESOURCE_GROUP_NAME=""
# STORAGE_ACCOUNT_NAME=""
# FUNCTION_APP_NAME=""
# CONTAINER_REGISTRY_NAME=""
# KEY_VAULT_NAME=""

# Kubernetes
# DEPLOYMENT_NAME=""
# SERVICE_NAME=""
# INGRESS_NAME=""

# ==============================================================
# OUTPUTS - POST-DEPLOYMENT VALUES
# ==============================================================
# These are values generated after resources are created.
# Fill these in as you provision infrastructure.

# Authentication
COGNITO_USERNAME="${TEST_USERNAME}"
COGNITO_PASSWORD="${TEST_PASSWORD}"

# API
API_ENDPOINT=""
API_BASE="${API_ENDPOINT}/prod"

# AWS Outputs
LAMBDA_ARN=""
API_GATEWAY_ID=""
S3_BUCKET=""
DYNAMODB_TABLE=""
IAM_ROLE_ARN=""

# Google Cloud Outputs
GCS_BUCKET=""
CLOUD_RUN_URL=""
CLOUD_FUNCTION_URL=""
SERVICE_ACCOUNT_EMAIL=""

# Azure Outputs
RESOURCE_GROUP=""
FUNCTION_APP_URL=""
STORAGE_ACCOUNT=""
CONTAINER_REGISTRY=""
KEY_VAULT_URI=""

# Kubernetes Outputs
CLUSTER_ENDPOINT=""
LOAD_BALANCER_IP=""
INGRESS_HOST=""